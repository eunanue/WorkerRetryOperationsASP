{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogSource": {
    "FolderPath": "C:\\Logs\\Itravel\\",
    "FileNamePrefix": "NotifyItravel_STP.log_",
    "FileNameExtension": ".log"
  },
  "FileLog": {
    "FolderPath": "logs",
    "FileNamePrefix": "WorkerRetryOperationsASP_",
    "RetainedFileCountLimit": 30
  },
  "RetryWorker": {
    "IntervalHours": 1,
    "RunOnStartup": true,
    "SqlCommandTimeoutSeconds": 60
  },
  "ConnectionStrings": {
    "AspDb": ""
  }
}
